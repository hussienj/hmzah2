{
  "name": "school-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:start": "electron .",
    "build:exe": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.school.management.app",
    "productName": "SchoolApp",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@google/genai": "^1.34.0",
    "@vitejs/plugin-react": "^5.1.2",
    "firebase": "^12.19.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.562.0",
    "path": "^0.12.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uuid": "^13.0.0",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
